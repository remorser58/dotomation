{
  "_comment": "Template: copy outside the repository as your own config and pass --config PATH, then replace hosts, paths, dots and repositories. 'local' means the machine running the tool; any other host is reached with ssh <host>. Paths may start with ~/.",
  "ledger": {
    "host": "local",
    "root": "~/.dots-ops/live",
    "dots": [
      "DOT-A",
      "DOT-B"
    ]
  },
  "dots": {
    "DOT-A": {
      "account": 1,
      "name": "A"
    },
    "DOT-B": {
      "account": 2,
      "name": "B"
    }
  },
  "activity": [
    {
      "dot": "DOT-A",
      "host": "local",
      "label": "local",
      "path": "~/.local/state/web-gpt-agent-a/app.log"
    },
    {
      "dot": "DOT-B",
      "host": "local",
      "label": "local",
      "path": "~/.local/state/web-gpt-agent-b/app.log"
    }
  ],
  "github": {
    "enabled": true,
    "repos": [
      "owner/repo"
    ],
    "cache_seconds": 300,
    "max_lookups": 60
  },
  "thresholds": {
    "stall_minutes": 30,
    "active_window_minutes": 15,
    "long_window_minutes": 60
  },
  "limits": {
    "tail_bytes": 262144,
    "command_timeout_seconds": 25,
    "gh_timeout_seconds": 25
  }
}
